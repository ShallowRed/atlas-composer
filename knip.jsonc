{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "treatConfigHintsAsErrors": true,
  // System binaries: diff of check:generated-types, cct of PROJ in the test of the neutral description
  "ignoreBinaries": ["diff", "cct"],
  // Cycles are warnings by default, and knip --cycles exits with 0 on a warning
  "rules": { "cycles": "error" },
  "workspaces": {
    // The app is private: the exports of its entry files (types/index.ts) need a reader too
    ".": { "includeEntryExports": true }
  }
}
