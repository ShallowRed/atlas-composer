{
  "name": "atlas-composer",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "license": "MIT",
  "imports": {
    "#package": "./package.json",
    "#types": "./types/index.ts",
    "#types/*": "./types/*.ts",
    "#scripts/*": "./scripts/*.ts"
  },
  "scripts": {
    "dev": "vite",
    "dev:debug": "VITE_DEBUG=ac:* vite",
    "dev:debug:store": "VITE_DEBUG=ac:store:* vite",
    "dev:debug:render": "VITE_DEBUG=ac:render:* vite",
    "dev:debug:overlay": "VITE_DEBUG=ac:render:overlay vite",
    "dev:debug:projection": "VITE_DEBUG=ac:projection:* vite",
    "dev:debug:preset": "VITE_DEBUG=ac:presets:* vite",
    "build": "pnpm build:packages && tsc && vite build",
    "build:analyze": "ANALYZE=true pnpm build",
    "build:packages": "pnpm -r --filter './packages/*' build",
    "generate:types": "json2ts -i configs/schemas/atlas-registry.schema.json -o types/atlas-registry.ts --no-additionalProperties && json2ts -i configs/schemas/atlas.schema.json -o types/atlas-config.ts --no-additionalProperties",
    "preview": "vite preview",
    "check": "pnpm build:packages && pnpm check:size && pnpm check:packages && pnpm check:generated-types && pnpm lint && pnpm typecheck && pnpm check:dead-code && pnpm test && pnpm geodata:validate --all",
    "check:dead-code": "knip && knip --cycles",
    "check:packages": "tsx scripts/check-packages.ts",
    "check:size": "pnpm --filter @atlas-composer/projection-loader size",
    "check:generated-types": "json2ts -i configs/schemas/atlas-registry.schema.json --no-additionalProperties | diff - types/atlas-registry.ts && json2ts -i configs/schemas/atlas.schema.json --no-additionalProperties | diff - types/atlas-config.ts",
    "typecheck": "pnpm typecheck:packages && pnpm typecheck:frontend && pnpm typecheck:scripts",
    "typecheck:packages": "pnpm typecheck:specification && pnpm typecheck:core && pnpm typecheck:loader && pnpm typecheck:preset-library && pnpm typecheck:cli",
    "typecheck:frontend": "vue-tsc --noEmit -p src/tsconfig.json",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "typecheck:specification": "pnpm --filter @atlas-composer/specification typecheck",
    "typecheck:core": "pnpm --filter @atlas-composer/projection-core typecheck",
    "typecheck:loader": "pnpm --filter @atlas-composer/projection-loader typecheck",
    "typecheck:preset-library": "pnpm --filter @atlas-composer/preset-library typecheck",
    "typecheck:cli": "pnpm --filter @atlas-composer/cli typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "geodata:analyze": "tsx scripts/dev/analyze-country.ts",
    "geodata:lookup": "tsx scripts/dev/lookup-country.ts",
    "geodata:prepare": "tsx scripts/prepare-geodata.ts",
    "geodata:validate": "tsx scripts/validate-configs.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "@atlas-composer/projection-core": "workspace:*",
    "@atlas-composer/specification": "workspace:*",
    "d3": "^7.9.2",
    "d3-composite-projections": "^2.0.0",
    "d3-geo": "^3.1.2",
    "d3-geo-projection": "^4.0.0",
    "daisyui": "^5.7.50",
    "debug": "^4.4.3",
    "pinia": "^4.1.0",
    "remixicon": "^4.9.1",
    "tailwindcss": "^4.3.4",
    "topojson-client": "^3.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "11",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@atlas-composer/projection-loader": "workspace:*",
    "@changesets/cli": "^3.0.3",
    "@tailwindcss/vite": "^4.3.4",
    "@types/d3": "^7.4.3",
    "@types/d3-geo": "^3.1.1",
    "@types/debug": "^4.1.13",
    "@types/node": "^24.6.2",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^15.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.36.0",
    "happy-dom": "^19.0.2",
    "json-schema-to-typescript": "^16.0.0",
    "knip": "^6.44.1",
    "rollup-plugin-visualizer": "^6.0.4",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.14",
    "world-atlas": "2.0.2"
  }
}
