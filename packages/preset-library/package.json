{
  "name": "@atlas-composer/preset-library",
  "type": "module",
  "version": "2.9.0",
  "description": "Curated collection of composite map projection presets for Atlas Composer",
  "author": "Lucas Poulain (ShallowRed)",
  "license": "MIT",
  "homepage": "https://github.com/ShallowRed/atlas-composer/tree/main/packages/preset-library#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShallowRed/atlas-composer.git",
    "directory": "packages/preset-library"
  },
  "bugs": {
    "url": "https://github.com/ShallowRed/atlas-composer/issues"
  },
  "keywords": [
    "atlas-composer",
    "brazil",
    "cartography",
    "chile",
    "composite-projection",
    "d3-geo",
    "ecuador",
    "fiji",
    "france",
    "indian-ocean",
    "japan",
    "macaronesia",
    "malaysia",
    "map-projection",
    "new-zealand",
    "norway",
    "portugal",
    "presets",
    "south-africa",
    "spain",
    "usa"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": "./dist/*.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@atlas-composer/projection-core": "workspace:*",
    "@atlas-composer/specification": "workspace:*",
    "@types/d3-geo": "^3.1.1",
    "@types/topojson-client": "^3.1.5",
    "ajv": "^8.20.0",
    "d3-geo": "^3.1.2",
    "topojson-client": "^3.1.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "world-atlas": "2.0.2"
  }
}
